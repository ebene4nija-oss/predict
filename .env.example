APP_NAME="Guaranteed Correct"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Password resets and email verification both depend on this, so `log`
# in production means a locked-out user never gets their reset link — the mail
# is written to the log file and silently dropped. Set real credentials before
# going live; the app refuses to boot on `log` when APP_ENV=production.
# Verification and reset mails are queued, so a queue worker must be running.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legal entity shown on /terms, /privacy and /refunds. The gateways check these
# against the registered merchant account, so they must name the entity that
# actually receives the money — not the product name.
LEGAL_OPERATOR="Guaranteed Correct"
LEGAL_ADDRESS=
LEGAL_JURISDICTION="the Federal Republic of Nigeria"
LEGAL_SUPPORT_EMAIL=support@guaranteedcorrectscoretips.com
LEGAL_UPDATED_AT="13 August 2026"

# Third Party Integration Keys
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Fixture & results feed. 'football_data' pulls real fixtures from
# football-data.org; 'sample' generates invented development fixtures and
# refuses to run in production.
FIXTURE_PROVIDER=football_data
FOOTBALL_DATA_TOKEN=

# Pricing. Checkout charges — and payment verification accepts — exactly these
# amounts, so a wrong value here is an underpayment hole, not a display bug.
# Visitors are routed to a gateway by country (see config/pricing.php);
# PRICING_DEFAULT_COUNTRY applies when the CDN sends no geo header.
PRICING_DEFAULT_COUNTRY=NG
PRICE_NGN=5000
PRICE_USD=4.99

# Payments. Leaving these blank enables local-only mock checkout; in production
# an unset key disables payments rather than granting free access.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# "Secret hash" from the Flutterwave dashboard. Required to accept webhooks.
FLUTTERWAVE_WEBHOOK_HASH=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_ID=
# Webhook id from the PayPal developer dashboard. Required to accept webhooks.
PAYPAL_WEBHOOK_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=GuaranteedCorrectBot
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=GuaranteedCorrectPicks
# Where the "Admin Support" button points. Handle or full invite link; blank
# hides the button. All four values above are overridable from Admin > Settings.
TELEGRAM_ADMIN_SUPPORT_URL=
# Random string passed to setWebhook and checked on every incoming update.
TELEGRAM_WEBHOOK_SECRET=

